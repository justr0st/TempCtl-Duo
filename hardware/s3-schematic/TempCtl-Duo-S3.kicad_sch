  (text ""
    (at 16.51 243.84 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 698dc170-bec8-5c9a-b1ad-b51b31a35d19))
  (text "A software controller is never the only protection: fit an"
    (at 16.51 247.015 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b128b9d2-4d9b-5986-acbb-365a29eef0f1))
  (text "independent over-temperature limiter and a contactor."
    (at 16.51 250.19 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 31891f81-e3f9-5318-a5f5-64d27957898d))
  (text "One or two controllers on the same A / B pair (own addresses)."
    (at 151.13 55.88 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid d110a645-b1c2-5203-8e82-71a017a11d36))
  (text "No answer: swap A / B. No 120 ohm terminators below 8 devices."
    (at 151.13 58.42 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid a9928057-0c48-573c-ae37-34c20fc5e400))
  (text "RGND not connected. Auto-direction module: DE / RE open."
    (at 151.13 60.96 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 47e22660-2769-5a5c-b99d-e50b3ca11dec))
  (text "Shared SCK / SO, one chip select per converter. R1 / R2 keep both"
    (at 151.13 147.32 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 3da82def-f941-5feb-a314-a7dcb06ac41c))
  (text "deselected while the ESP32 boots. MAX6675 modules fit the same way."
    (at 151.13 149.86 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 6580b5f1-fd93-5b47-a7c5-3669edf58135))
  (text "Active-high DC solid-state relay (input 3-32 V DC), driven"
    (at 151.13 203.2 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 89f705a7-7774-56a0-ac10-eb5a2af801ec))
  (text "directly by GPIO4: input current at most 20 mA at 3.3 V,"
    (at 151.13 206.375 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 25d6945d-1528-5897-8b0e-c056982a2698))
  (text "output at least 0.5 A DC. GPIO4 is low (off) from the first"
    (at 151.13 209.55 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid fe44b716-c6b8-515c-8cbb-22176cb20986))
  (text "line of setup(). On while a local channel heats, off at once"
    (at 151.13 212.725 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 4d3bdb76-80e0-5c30-973d-82ac7fe975cc))
  (text "on a fault or E-stop. It covers a stuck SSR input or driver;"
    (at 151.13 215.9 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid d66b7edd-9100-573f-b875-7cc24d943824))
