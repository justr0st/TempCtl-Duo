  (text "J1 = left header, J3 = right header (top view, USB ports at the bottom)."
    (at 16.51 92.71 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e72344eb-77bd-5020-91f1-afbc512e4e91))
  (text "5 V from USB (J1-21), 3V3 from the DevKit's regulator (J1-1 / J1-2)."
    (at 16.51 95.25 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 50856a14-d76e-5407-95cc-5daeaf582540))
  (text "Not connected: GPIO35-37 (octal PSRAM), 19/20 and 43/44 (both USB"
    (at 16.51 97.79 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 812a5742-aa33-54d4-bcee-e78d0ecc1b08))
  (text "ports), strapping pins 0, 3, 45, 46; GPIO48 = on-board status LED."
    (at 16.51 100.33 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid f70a3972-3513-57a4-8c94-7560bd537e57))
  (text "one ground for the DevKit and every module"
    (at 24.13 106.68 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 7ebc9f24-0f16-56cb-a7bf-d8dc9351e078))
  (text "VCC 5 V (backlight about 100 mA), logic 3.3 V (level shifters on the module)."
    (at 16.51 180.34 0)
