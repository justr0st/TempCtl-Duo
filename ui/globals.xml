<globals>
	<!-- Design tokens for the TempCtl UI. Reference consts as #name, fonts by
	     name, styles with <style name="..."/>.

	     Fonts: the firmware maps these names to LVGL's built-in Montserrat
	     fonts (lv_font_montserrat_12/14/20/48, which already contain the
	     FontAwesome symbols), so keep the names and sizes in sync with
	     src/ui.cpp (uiRegisterFonts) if you change them. The TTF/WOFF files
	     are only used by the editor preview. -->

	<consts>
		<!-- Colors -->
		<color name="color_bg" value="0x15171A" help="Screen background" />
		<color name="color_panel" value="0x24272D" help="Inputs, tables, chart background" />
		<color name="color_border" value="0x3A3F47" help="Panel borders" />
		<color name="color_text" value="0xF2F4F7" help="Primary text" />
		<color name="color_muted" value="0x9AA3AF" help="Secondary text and captions" />
		<color name="color_accent" value="0x2196F3" help="Buttons, selection" />
		<color name="color_danger" value="0xF44336" help="Stop button" />
		<color name="color_pv" value="0xFF5722" help="Process value (temperature)" />
		<color name="color_sp" value="0x03A9F4" help="Setpoint" />
		<color name="color_plan" value="0x90A4AE" help="Program curve" />
		<color name="color_ok" value="0x4CAF50" help="Link OK" />
		<color name="color_warn" value="0xFFC107" help="Warnings / unsaved" />

		<!-- Spacing -->
		<int name="space_xs" value="2" />
		<int name="space_sm" value="4" />
		<int name="space_md" value="8" />
		<int name="tab_bar_height" value="32" />
		<int name="row_height" value="34" />
	</consts>

	<fonts>
		<bin name="font_12" src_path="fonts/Montserrat-Medium.ttf" size="12" bpp="4" range="0x20-0x7F" as_file="false" />
		<bin name="font_14" src_path="fonts/Montserrat-Medium.ttf" size="14" bpp="4" range="0x20-0x7F" as_file="false" />
		<bin name="font_20" src_path="fonts/Montserrat-Medium.ttf" size="20" bpp="4" range="0x20-0x7F" as_file="false" />
		<bin name="font_48" src_path="fonts/Montserrat-Medium.ttf" size="48" bpp="4" range="0x20-0x7F" as_file="false" />
		<!-- Icon glyphs (play, pause, stop, next, plus, minus, up, down, edit,
		     save, refresh, wi-fi, warning) for icon-only buttons -->
		<bin name="font_icons_14" src_path="fonts/FontAwesome5.ttf" size="14" bpp="4"
			range="0xF04B-0xF04D,0xF051,0xF067,0xF068,0xF077,0xF078,0xF304,0xF0C7,0xF021,0xF1EB,0xF071" as_file="false" />
	</fonts>

	<styles>
		<style name="style_screen" bg_color="#color_bg" bg_opa="100%" text_color="#color_text" text_font="font_14" />
		<!-- transparent container without padding (component roots, rows) -->
		<style name="style_plain" bg_opa="0" border_width="0" pad_all="0" radius="0" />
		<style name="style_page" bg_color="#color_bg" bg_opa="100%" border_width="0" radius="0" pad_all="#space_sm" />
		<style name="style_caption" text_color="#color_muted" text_font="font_12" />
		<style name="style_small" text_font="font_12" />
		<style name="style_panel" bg_color="#color_panel" bg_opa="100%" border_color="#color_border" border_width="1"
			text_color="#color_text" />
		<style name="style_tab_bar" bg_color="#color_panel" bg_opa="100%" text_color="#color_text" />
		<style name="style_row" bg_opa="0" border_width="0" pad_all="#space_xs" radius="0" />
		<style name="style_danger" bg_color="#color_danger" />
		<!-- per-part styles (use with selector="items" / "indicator") -->
		<style name="style_table_cell" pad_top="3" pad_bottom="3" pad_left="4" pad_right="4" />
		<style name="style_chart_line" line_width="2" />
		<style name="style_no_points" width="0" height="0" />
		<style name="style_scale_ticks" length="4" />
		<style name="style_scale_line" line_opa="0" />
	</styles>
</globals>
