	<styles>
		<style name="style_screen" bg_color="#color_bg" bg_opa="100%" text_color="#color_text" text_font="font_14" />
		<!-- transparent container without padding (component roots, rows) -->
		<style name="style_plain" bg_opa="0" border_width="0" pad_all="0" radius="0" />
		<style name="style_page" bg_color="#color_bg" bg_opa="100%" border_width="0" radius="0" pad_all="#space_sm" />
		<style name="style_caption" text_color="#color_muted" text_font="font_12" />
		<style name="style_small" text_font="font_12" />
		<style
			name="style_panel"
			bg_color="#color_panel"
			bg_opa="100%"
			border_color="#color_border"
			border_width="1"
			text_color="#color_text"
		/>
		<style name="style_tab_bar" bg_color="#color_panel" bg_opa="100%" text_color="#color_text" />
		<style name="style_row" bg_opa="0" border_width="0" pad_all="#space_xs" radius="0" />
		<style name="style_danger" bg_color="#color_danger" />
		<!-- single-colour styles. Colours of widgets must come from named styles
		     (not style_..._color on the widget) so the palette can change them;
		     every colour in a style needs a line in src/ui_gen.c (STYLE_COLORS). -->
		<style name="style_text_pv" text_color="#color_pv" />
		<style name="style_text_sp" text_color="#color_sp" />
		<style name="style_text_plan" text_color="#color_plan" />
		<style name="style_text_warn" text_color="#color_warn" />
		<style name="style_text_accent" text_color="#color_accent" />
		<style name="style_border_accent" border_color="#color_accent" />
		<style name="style_bg_ok" bg_color="#color_ok" />
		<!-- per-part styles (use with selector="items" / "indicator") -->
		<style name="style_table_cell" pad_top="3" pad_bottom="3" pad_left="4" pad_right="4" />
		<style name="style_chart_line" line_width="2" />
		<style name="style_no_points" width="0" height="0" />
		<style name="style_scale_ticks" length="4" />
		<style name="style_scale_line" line_opa="0" />
		<style name="style_link_error" bg_color="#color_danger" />
		<!-- popups (components/popups) -->
		<style
			name="style_popup"
			bg_color="#color_panel"
			bg_opa="100%"
			border_width="0"
			radius="0"
			pad_all="#space_sm"
			text_color="#color_text"
		/>
		<style name="style_backdrop" bg_color="0x000000" bg_opa="50%" border_width="0" radius="0" pad_all="0" />
		<style
			name="style_dialog"
			bg_color="#color_panel"
			bg_opa="100%"
			border_color="#color_border"
			border_width="1"
			radius="8"
			pad_all="10"
			text_color="#color_text"
		/>
		<style name="style_list" pad_all="0" radius="4" />
		<!-- Wi-Fi scan spinner: use for the main part and with selector="indicator" -->
		<style name="style_spinner" arc_width="4" />
		<style
			name="style_list_item"
			bg_color="#color_panel"
			bg_opa="100%"
			radius="0"
			shadow_width="0"
			border_color="#color_border"
			border_width="1"
			border_side="bottom"
			text_color="#color_text"
			pad_hor="10"
		/>
	</styles>
