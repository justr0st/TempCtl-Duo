<!-- LVGL Pro project for the TempCtl touch UI (ESP32-2432S028R, 320x240).
     Open this folder in LVGL Pro Editor. After editing run "Export C code":
     the firmware (LVGL 9.6) compiles the exported *_gen.c files, not the XML.
     9.5.0 is the newest version the editor offers; its code builds with 9.6. -->
<project name="tempctl_ui" lvgl_version="9.5.0" theme="default">
	<targets>
		<target name="cyd">
			<display width="320" height="240" />
		</target>
	</targets>
</project>
