<!-- Main page: live values, manual setpoint, program selection and run
     controls. Texts marked "set by firmware" are placeholders for the preview. -->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="style_plain" />

		<!-- process value and controller setpoint -->
		<lv_label x="2" y="0" text="Process value (C)">
			<style name="style_caption" />
		</lv_label>
		<lv_label name="main_pv" x="0" y="12" text="153.8" style_text_font="font_48" style_text_color="#color_pv" />
		<lv_label name="main_sp" x="2" y="62" text="SP 150.0" style_text_font="font_20" style_text_color="#color_sp" />

		<!-- status column (set by firmware) -->
		<lv_obj name="main_link" x="296" y="2" width="12" height="12" scrollable="false"
			style_radius="6" style_border_width="0" style_bg_color="#color_ok" style_bg_opa="100%" />
		<lv_label name="main_state" x="176" y="0" text="Idle" style_text_font="font_20" />
		<lv_label name="main_phase" x="176" y="24" text="Ramp 36:40 left">
			<style name="style_small" />
		</lv_label>
		<lv_label name="main_total" x="176" y="38" width="140" long_mode="dots" text="Example, 10:18:05">
			<style name="style_small" />
		</lv_label>
		<lv_label name="main_out" x="176" y="52" text="Out 37%">
			<style name="style_small" />
		</lv_label>
		<lv_label name="main_mode" x="236" y="52" text="Automatic">
			<style name="style_small" />
		</lv_label>
		<lv_label name="main_target" x="176" y="68" text="">
			<style name="style_small" />
		</lv_label>

		<!-- manual setpoint -->
		<lv_label x="2" y="100" text="Manual SP" />
		<lv_button name="main_man_sp" x="90" y="92" width="92" height="#row_height">
			<lv_label name="main_man_sp_text" align="center" text="150.0" />
		</lv_button>
		<lv_switch name="main_man_sw" x="192" y="95" width="54" height="28" />
		<lv_label x="254" y="102" text="on / off">
			<style name="style_caption" />
		</lv_label>

		<!-- program selection and run controls -->
		<lv_dropdown name="main_prog" x="0" y="132" width="140" height="36" options="1 Example" style_pad_all="8">
			<style name="style_panel" />
		</lv_dropdown>
		<lv_button name="main_start" x="144" y="132" width="46" height="36">
			<lv_label align="center" text="&#xF04B;" style_text_font="font_icons_14" />
		</lv_button>
		<lv_button name="main_pause" x="194" y="132" width="38" height="36">
			<lv_label align="center" text="&#xF04C;" style_text_font="font_icons_14" />
		</lv_button>
		<lv_button name="main_stop" x="236" y="132" width="38" height="36">
			<style name="style_danger" />
			<lv_label align="center" text="&#xF04D;" style_text_font="font_icons_14" />
		</lv_button>
		<lv_button name="main_skip" x="278" y="132" width="38" height="36">
			<lv_label align="center" text="&#xF051;" style_text_font="font_icons_14" />
		</lv_button>

		<lv_bar name="main_progress" x="2" y="174" width="312" height="6" min_value="0" max_value="1000" value="380" />
		<lv_label name="main_msg" x="2" y="184" width="312" long_mode="dots" text="Program started">
			<style name="style_small" />
		</lv_label>
	</view>
</component>
