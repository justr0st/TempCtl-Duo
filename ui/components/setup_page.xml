<!-- Setup page: a second tab view with System (ESP32) and Controller
     (temperature controller) settings. -->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="style_plain" />
		<lv_tabview name="setup_tabs" width="100%" height="100%" tab_bar_position="top">
			<lv_tabview-tab_bar height="28">
				<style name="style_tab_bar" />
			</lv_tabview-tab_bar>
			<lv_tabview-tab text="System">
				<style name="style_page" />
				<system_panel />
			</lv_tabview-tab>
			<lv_tabview-tab text="Controller">
				<style name="style_page" />
				<controller_panel />
			</lv_tabview-tab>
		</lv_tabview>
	</view>
</component>
