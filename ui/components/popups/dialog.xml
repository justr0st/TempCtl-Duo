<!-- Popup: message / question box over a dimmed screen. Used for the stop
     question, "unsaved changes", save results, link test and the Wi-Fi
     "Connecting..." message. The firmware sets title and text, labels the
     buttons it needs and hides the rest (dlg_btn1..3, dlg_close). -->
<component>
	<previews>
		<preview name="cyd" width="320" height="240" />
	</previews>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="style_backdrop" />
		<lv_obj name="dlg_panel" width="290" height="content" align="center" flex_flow="column" scrollable="false"
			style_pad_row="10">
			<style name="style_dialog" />
			<lv_obj width="100%" height="content" flex_flow="row" scrollable="false" style_flex_cross_place="center">
				<style name="style_plain" />
				<lv_label name="dlg_title" flex_grow="1" long_mode="dots" text="Stop program?" style_text_font="font_20" />
				<lv_button name="dlg_close" width="36" height="32">
					<lv_label align="center" text="&#xF00D;" style_text_font="font_icons_14" />
				</lv_button>
			</lv_obj>
			<lv_label name="dlg_text" width="100%" text="The end action from Setup &gt; Controller is applied." />
			<lv_obj name="dlg_footer" width="100%" height="content" flex_flow="row" scrollable="false"
				style_flex_main_place="space_evenly">
				<style name="style_plain" />
				<lv_button name="dlg_btn1" width="80" height="36">
					<lv_label align="center" text="Stop" />
				</lv_button>
				<lv_button name="dlg_btn2" width="80" height="36">
					<lv_label align="center" text="Cancel" />
				</lv_button>
				<lv_button name="dlg_btn3" width="80" height="36">
					<lv_label align="center" text="Other" />
				</lv_button>
			</lv_obj>
		</lv_obj>
	</view>
</component>
